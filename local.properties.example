## This file is a template for local.properties
## Copy this file to local.properties and fill in your actual Coinbase API credentials
## local.properties is gitignored and will not be committed

## Coinbase Advanced Trade API Credentials
## Get these from: https://coinbase.com/settings/api
coinbase.api.key=organizations/YOUR_ORG_ID/apiKeys/YOUR_KEY_ID
coinbase.api.secret=YOUR_PRIVATE_KEY_HERE

## Example (DO NOT USE - replace with your actual credentials):
# coinbase.api.key=organizations/abc-123-def/apiKeys/key-xyz-789
# coinbase.api.secret=oBU6zKzJ8fEEznO9Co+QagXSKVtBScpgjwaNgukWHb9r5Ug2V8wFBOOI/6NUEkjpu8NMGthfwBgMGY9xLvHitw==
